# ====================================================================
# Git Ignore Configuration - Security & Clean Repository Policy
# ====================================================================

# 1. Environment & Private Secrets (CRITICAL)
# Ignore all environment variable files
.env*
# Explicitly allow the sanitized example template
!.env.example

# Private Keys, Certificates, and Keystores
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
id_rsa*
id_ed25519*

# Cloud & Service Account Credentials
*credentials*.json
*secret*.json
serviceAccountKey*.json
*firebase-adminsdk*.json

# Platform & Deployment State
.vercel
.turbo
.supabase/
!.supabase/migrations/
!.supabase/config.toml

# 2. Database Dumps, Backups, and Local DBs
*.dump
*.sql.dump
*.backup
*.bak
*.sqlite
*.sqlite3
*.db

# 3. Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 4. Next.js & Build Outputs
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# 5. Testing & Coverage
/coverage/
*.lcov
.nyc_output
AGENTS.md

# 6. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.playwright-mcp

# 7. Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Code Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.swp
*.swo

# 8. Local AI Agent Tooling / Caches
.agents/
