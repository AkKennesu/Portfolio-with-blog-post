# PostgreSQL connection string
# For Supabase, use transaction pooler (port 6543) for serverless deployments
POSTGRES_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# JWT Secret for admin sessions (generate a secure random 32+ character string)
JWT_SECRET="your-strong-random-32-char-jwt-secret-key-here"

# Admin Dashboard Password (used for administrative login)
ADMIN_PASSWORD="your-super-secret-admin-password"
